{
  "name": "@acb/bff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "oxlint src test"
  },
  "dependencies": {
    "@acb/contracts": "0.1.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/csrf-protection": "8.0.2",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "^10.1.5",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/session": "11.1.5",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "jose": "6.2.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
