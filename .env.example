# Compose (docker compose reads this file automatically). Never commit a real .env.
PUBLIC_ORIGIN=http://localhost:8080
PROXY_PORT=8080

# Origin of the auth microservice. From containers, use host.docker.internal
# for a service running on this machine, e.g. http://host.docker.internal:8084
AUTH_BASE_URL=http://host.docker.internal:8084

# Generate two independent secrets:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SIGNING_SECRET=
SESSION_ENCRYPTION_KEY=

SESSION_TTL_SECONDS=3600
UPSTREAM_TIMEOUT_MS=8000
TRUSTED_PROXY=172.16.0.0/12

# Optional: run the real Redis integration test against the compose Redis
# BFF_TEST_REDIS_URL=redis://localhost:6379
