# Compose (docker compose reads this file automatically). Never commit a real .env.
#
# Optional. When set, only that exact origin is accepted (use it for a fixed
# HTTPS deployment). When unset, the BFF accepts each request's own origin, so
# localhost, any LAN IP and any tunnel URL work without changes.
# The session cookie is then named "acb_session" without the Secure flag.
# PUBLIC_ORIGIN=https://dashboard.example.com
WEB_PORT=8080

# Origin of the API gateway. The BFF reaches auth and admin_users through it,
# so the gateway must expose /api/v1/auth and /api/v1/{students,guides,search}.
AUTH_BASE_URL=http://host.docker.internal:5062

# Origin of the admin_users microservice, reached through the gateway.
ADMIN_USERS_BASE_URL=http://host.docker.internal:5062
GEO_BASE_URL=http://host.docker.internal:8000

# Generate two independent secrets:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SIGNING_SECRET=
SESSION_ENCRYPTION_KEY=

SESSION_TTL_SECONDS=3600
UPSTREAM_TIMEOUT_MS=8000
TRUSTED_PROXY=172.16.0.0/12

# Optional: run the real Redis integration test against the compose Redis
# BFF_TEST_REDIS_URL=redis://localhost:6380
